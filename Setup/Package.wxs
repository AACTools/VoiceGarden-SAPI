<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="$(var.ProductName)"
    Manufacturer="$(var.Manufacturer)"
    Version="$(var.ProductVersion)"
    UpgradeCode="5A7A242A-1414-41D0-A1C5-6A1E338F0B7C">

    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.InstallFolderName)" />
    </StandardDirectory>

    <Property Id="ARPCONTACT" Value="$(var.ProjectUrl)" />
    <Property Id="ARPURLINFOABOUT" Value="$(var.ProjectUrl)" />
    <Property Id="REMOVE_APPDATA" Value="0" />

    <!--
      Optional appdata cleanup:
      msiexec /x {PRODUCT-CODE} REMOVE_APPDATA=1
    -->
    <CustomAction
      Id="CleanupAppData"
      Directory="SystemFolder"
      ExeCommand='cmd.exe /c if exist "[LocalAppDataFolder]VoiceGardenSAPIAdapter" rmdir /s /q "[LocalAppDataFolder]VoiceGardenSAPIAdapter"'
      Execute="deferred"
      Impersonate="yes"
      Return="ignore" />

    <!-- Register COM DLL during install -->
    <CustomAction
      Id="RegisterDlls"
      Directory="SystemFolder"
      ExeCommand='regsvr32 /s "[INSTALLFOLDER]x64\VoiceGardenSAPIAdapter.dll"'
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <!-- Unregister COM DLLs on uninstall -->
    <CustomAction
      Id="UnregisterDlls"
      Directory="SystemFolder"
      ExeCommand='regsvr32 /u /s "[INSTALLFOLDER]x64\VoiceGardenSAPIAdapter.dll"'
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RegisterDlls" After="InstallFiles" Condition='NOT Installed' />
      <Custom Action="CleanupAppData" Before="RemoveFiles" Condition='REMOVE="ALL" AND REMOVE_APPDATA=1' />
      <Custom Action="UnregisterDlls" Before="RemoveFiles" Condition='REMOVE="ALL"' />
    </InstallExecuteSequence>

    <Feature Id="MainFeature" Title="$(var.ProductName)" Level="1">
      <ComponentGroupRef Id="PayloadComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="$(var.ProductName)" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ShortcutComponents">
      <Component Id="StartMenuShortcutComponent" Directory="ApplicationProgramsFolder" Guid="*">
        <Shortcut
              Id="StartMenuInstallerShortcut"
              Name="$(var.InstallerShortcutName)"
              Description="VoiceGarden Configuration Tool"
              Target="[INSTALLFOLDER]VoiceGarden.UI.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\VoiceGardenSAPIAdapter" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="*">
        <Shortcut
              Id="DesktopInstallerShortcut"
              Name="$(var.InstallerShortcutName)"
              Description="VoiceGarden Configuration Tool"
              Target="[INSTALLFOLDER]VoiceGarden.UI.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\VoiceGardenSAPIAdapter" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
