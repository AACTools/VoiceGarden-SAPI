<Project Sdk="PanelSwWix4.Sdk/5.0.0-psw-wix.0113-3">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <ProductVersion Condition="'$(ProductVersion)'==''">0.3.0.0</ProductVersion>
    <PayloadDir Condition="'$(PayloadDir)'==''">$(MSBuildProjectDirectory)\..\out</PayloadDir>
    <ProductName Condition="'$(ProductName)'==''">NaturalVoiceSAPIAdapter</ProductName>
    <Manufacturer Condition="'$(Manufacturer)'==''">NaturalVoiceSAPIAdapter</Manufacturer>
    <InstallFolderName Condition="'$(InstallFolderName)'==''">NaturalVoiceSAPIAdapter</InstallFolderName>
    <InstallerShortcutName Condition="'$(InstallerShortcutName)'==''">NaturalVoiceSAPIAdapter Installer</InstallerShortcutName>
    <ProjectUrl Condition="'$(ProjectUrl)'==''">https://github.com/gexgd0419/NaturalVoiceSAPIAdapter</ProjectUrl>
    <DefineConstants>ProductVersion=$(ProductVersion);PayloadDir=$(PayloadDir);ProductName=$(ProductName);Manufacturer=$(Manufacturer);InstallFolderName=$(InstallFolderName);InstallerShortcutName=$(InstallerShortcutName);ProjectUrl=$(ProjectUrl)</DefineConstants>
  </PropertyGroup>
</Project>
