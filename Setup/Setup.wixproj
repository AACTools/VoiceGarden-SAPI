<Project Sdk="PanelSwWix4.Sdk/5.0.0-psw-wix.0113-3">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <ProductVersion Condition="'$(ProductVersion)'==''">0.4.7.0</ProductVersion>
    <PayloadDir Condition="'$(PayloadDir)'==''">$(MSBuildProjectDirectory)\..\out</PayloadDir>
    <ProductName Condition="'$(ProductName)'==''">VoiceGardenSAPIAdapter</ProductName>
    <Manufacturer Condition="'$(Manufacturer)'==''">VoiceGardenSAPIAdapter</Manufacturer>
    <InstallFolderName Condition="'$(InstallFolderName)'==''">VoiceGardenSAPIAdapter</InstallFolderName>
    <InstallerShortcutName Condition="'$(InstallerShortcutName)'==''">VoiceGardenSAPIAdapter Installer</InstallerShortcutName>
    <ProjectUrl Condition="'$(ProjectUrl)'==''">https://github.com/gexgd0419/VoiceGardenSAPIAdapter</ProjectUrl>
    <DefineConstants>ProductVersion=$(ProductVersion);PayloadDir=$(PayloadDir);ProductName=$(ProductName);Manufacturer=$(Manufacturer);InstallFolderName=$(InstallFolderName);InstallerShortcutName=$(InstallerShortcutName);ProjectUrl=$(ProjectUrl)</DefineConstants>
  </PropertyGroup>
</Project>
