<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VoiceGarden.UI.ViewModels"
        xmlns:views="using:VoiceGarden.UI.Views"
        xmlns:lang="using:VoiceGarden.UI.Markup"
        x:Class="VoiceGarden.UI.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{lang:Localize AppName}"
        Width="960" Height="680"
        MinWidth="640" MinHeight="520"
        FontSize="14"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *" Margin="20,16,20,16">

        <!-- Screen reader announcement region (invisible, announces tab changes) -->
        <TextBlock Text="{Binding ScreenReaderAnnouncement}" IsVisible="False"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.Name="{Binding ScreenReaderAnnouncement}"/>

        <!-- App header -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,14">
            <TextBlock Grid.Column="0" Text="{Binding AppName}" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource VGForegroundBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="{lang:Localize Close}" Click="Close_Click" Classes="Primary"
                    AutomationProperties.Name="Close VoiceGarden"/>
        </Grid>

        <!-- 3-tab accessible flow + Advanced -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent">

            <!-- Tab 1 — Voice Engines -->
            <TabItem AutomationProperties.Name="{Binding EnginesTabHeader}">
                <TabItem.Header>
                    <StackPanel Spacing="1">
                        <TextBlock Text="{Binding EnginesTabHeader}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding EnginesTabState}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </TabItem.Header>
                <views:EnginesView DataContext="{Binding Engines}" Margin="0,16,0,0"/>
            </TabItem>

            <!-- Tab 2 — Credentials (disabled unless a selected engine needs them) -->
            <TabItem IsEnabled="{Binding CredentialsTabEnabled}"
                     AutomationProperties.Name="{Binding CredentialsTabState, StringFormat='Credentials tab: {0}'}">
                <TabItem.Header>
                    <StackPanel Spacing="1">
                        <TextBlock Text="{Binding CredentialsTabHeader}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CredentialsTabState}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </TabItem.Header>
                <views:CredentialsView DataContext="{Binding Credentials}" Margin="0,16,0,0"/>
            </TabItem>

            <!-- Tab 3 — Voices -->
            <TabItem AutomationProperties.Name="{Binding VoicesTabState, StringFormat='Voices tab: {0}'}">
                <TabItem.Header>
                    <StackPanel Spacing="1">
                        <TextBlock Text="{Binding VoicesTabHeader}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding VoicesTabState}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </TabItem.Header>
                <views:VoicesView DataContext="{Binding Voices}" Margin="0,16,0,0"/>
            </TabItem>

            <!-- Advanced — everything else -->
            <TabItem AutomationProperties.Name="{lang:Localize Advanced}">
                <TabItem.Header>
                    <StackPanel Spacing="1">
                        <TextBlock Text="{lang:Localize Advanced}" FontWeight="SemiBold"/>
                        <TextBlock Text="{lang:Localize AdvancedTabState}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </TabItem.Header>
                <views:AdvancedView Margin="0,16,0,0"/>
            </TabItem>

        </TabControl>
    </Grid>

</Window>
