<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VoiceGarden.UI.ViewModels"
        xmlns:models="using:VoiceGarden.UI.Models"
        xmlns:views="using:VoiceGarden.UI.Views"
        x:Class="VoiceGarden.UI.MainWindow"
        Title="VoiceGarden"
        Width="680" Height="720"
        MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="*">

        <!-- ========== MAIN VIEW ========== -->
        <ScrollViewer Grid.Row="0" IsVisible="{Binding IsMainViewVisible}" Padding="0">
            <StackPanel Margin="24" Spacing="16">

                <!-- Adapter Installation -->
                <Border Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Adapter Installation" Classes="CardHeader"/>
                        <Grid ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Status64Bit}" VerticalAlignment="Center"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="{Binding Install64Text}"
                                    Command="{Binding Install64Command}" Margin="8,0,0,0" Padding="20,4" MinWidth="90"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="Uninstall"
                                    Command="{Binding Uninstall64Command}" Margin="8,0,0,0" Padding="20,4" MinWidth="90"
                                    IsEnabled="{Binding Is64Installed}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Status32Bit}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="{Binding Install32Text}"
                                    Command="{Binding Install32Command}" Margin="8,8,0,0" Padding="20,4" MinWidth="90"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="Uninstall"
                                    Command="{Binding Uninstall32Command}" Margin="8,8,0,0" Padding="20,4" MinWidth="90"
                                    IsEnabled="{Binding Is32Installed}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Voice Engines -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Voice Engines" Classes="CardHeader"/>

                        <!-- Offline -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Offline Voices" Classes="SectionLabel"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                <CheckBox IsChecked="{Binding SherpaEnabled}" Content="SherpaOnnx Neural TTS" MinWidth="200" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SherpaModelSummary}" Classes="Hint" VerticalAlignment="Center"/>
                                <Button Content="Manage Models..." Command="{Binding OpenSherpaManagerCommand}"
                                        Padding="12,2" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>

                        <Separator Margin="0,4"/>

                        <!-- Cloud Engines -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Cloud Voices" Classes="SectionLabel"/>

                            <!-- Scrollable engine checkbox grid -->
                            <Border BorderBrush="{DynamicResource SystemControlDefaultChromeMediumLowBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="8" MaxHeight="200">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding CloudEngines}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:CloudEngineSetting">
                                                <CheckBox IsChecked="{Binding Enabled}" Content="{Binding DisplayName}"
                                                          Margin="0,3" MinWidth="120"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Content="Configure Credentials..." Command="{Binding OpenEngineConfigCommand}"
                                        Padding="16,4" MinWidth="160"/>
                                <Button Content="Configure Voices..." Command="{Binding OpenVoiceConfigCommand}"
                                        Padding="16,4" MinWidth="140"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Advanced (Collapsible, hidden by default) -->
                <Border Classes="Card" IsVisible="{Binding ShowAdvanced}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Advanced" Classes="CardHeader"/>
                        <CheckBox Content="Enable Edge browser voices" IsChecked="{Binding EdgeEnabled}" Margin="0"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <TextBlock Text="Log level:" VerticalAlignment="Center"/>
                            <ComboBox SelectedIndex="{Binding LogLevelIndex}" MinWidth="100">
                                <ComboBoxItem Content="Normal"/>
                                <ComboBoxItem Content="Info"/>
                                <ComboBoxItem Content="Trace"/>
                            </ComboBox>
                            <Button Content="Open Logs" Command="{Binding OpenLogsCommand}" Padding="12,2"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ToggleButton Content="{Binding AdvancedToggleText}" IsChecked="{Binding ShowAdvanced}"
                              Padding="12,4" HorizontalAlignment="Left" FontSize="12"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                    <Button Content="About" Command="{Binding ShowAboutCommand}" Padding="20,6"/>
                    <Button Content="Close" Click="Close_Click" Classes="Primary" Padding="20,6"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ========== VOICE CONFIG VIEW ========== -->
        <Grid Grid.Row="0" IsVisible="{Binding IsVoiceConfigVisible}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="24,16,24,8">
                <Button Content="← Back" Command="{Binding BackToMainCommand}" Padding="12,4"/>
                <TextBlock Text="Configure Voices" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <views:VoiceConfigView Grid.Row="1" DataContext="{Binding VoiceConfig}" Margin="24,0,24,16"/>
        </Grid>

        <!-- ========== ENGINE CONFIG VIEW ========== -->
        <Grid Grid.Row="0" IsVisible="{Binding IsEngineConfigVisible}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="24,16,24,8">
                <Button Content="← Back" Command="{Binding BackToMainCommand}" Padding="12,4"/>
                <TextBlock Text="Configure Credentials" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" Margin="24,0,24,16">
                <StackPanel Spacing="8">
                    <ItemsControl ItemsSource="{Binding CloudEngines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:CloudEngineSetting">
                                <Border Classes="EngineRow" IsVisible="{Binding Enabled}" Margin="0,2">
                                    <Grid ColumnDefinitions="120, *, 100, Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                   FontWeight="Medium" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding ApiKey}"
                                                 Watermark="API Key" PasswordChar="*"
                                                 Margin="8,0" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2" Text="{Binding Region}"
                                                 Watermark="Region" IsVisible="{Binding NeedsRegion}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="" />
        <!-- ========== ABOUT VIEW ========== -->
        <Grid Grid.Row="0" IsVisible="{Binding IsAboutVisible}" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                <Button Content="← Back" Command="{Binding BackToMainCommand}" Padding="12,4"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="12" MaxWidth="500">
                    <TextBlock Text="{Binding AboutText}" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Only enabled engines are shown. Toggle engines on the main page."
                               Classes="Hint" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ========== SHERPA MODELS VIEW ========== -->
        <Grid Grid.Row="0" IsVisible="{Binding IsSherpaManagerVisible}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="24,16,24,8">
                <Button Content="← Back" Command="{Binding BackToMainCommand}" Padding="12,4"/>
                <TextBlock Text="SherpaOnnx Models" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <views:SherpaModelsView Grid.Row="1" DataContext="{Binding SherpaModels}" Margin="24,0,24,16"/>
        </Grid>

    </Grid>

    <Window.Styles>
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource SystemRegionBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlDefaultChromeMediumLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.EngineRow">
            <Setter Property="Background" Value="{DynamicResource ControlExampleDisplayBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style Selector="TextBlock.CardHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="TextBlock.SectionLabel">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="TextBlock.Hint">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.Primary">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

</Window>
