<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="using:VoiceGarden.UI.Markup"
        xmlns:vm="using:VoiceGarden.UI"
        x:Class="VoiceGarden.UI.OnboardingWindow"
        x:DataType="vm:OnboardingWindowViewModel"
        Title="{lang:Localize OnboardingTitle}"
        Width="600" Height="620"
        MinWidth="560" MinHeight="560"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SystemDecorations="Full"
        Background="White">

    <Grid RowDefinitions="*, Auto">

        <!-- Screen reader page announcer -->
        <TextBlock x:Name="PageAnnouncer" Grid.Row="0" IsVisible="False"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.Name=""/>

        <!-- ========== PAGE CONTENT (swaps via IsVisible) ========== -->
        <ScrollViewer Grid.Row="0" Padding="0">

            <StackPanel>

                <!-- ===== PAGE 1: WELCOME ===== -->
                <StackPanel IsVisible="{Binding IsPage1}" Spacing="0">

                    <!-- Logo header band -->
                    <Border Background="{StaticResource VGAccentBrush}" Padding="40,40,40,28">
                        <StackPanel HorizontalAlignment="Center" Spacing="16">
                            <Image Source="/Assets/logo-small.png"
                                   Width="96" Height="96"
                                   HorizontalAlignment="Center"/>
                            <TextBlock Text="{lang:Localize AppName}"
                                        FontSize="32" FontWeight="Bold"
                                        Foreground="{StaticResource VGForegroundBrush}"
                                        HorizontalAlignment="Center"/>
                            <TextBlock Text="{lang:Localize NeuralTTSForSAPI}"
                                       FontSize="14"
                                       Foreground="{StaticResource VGMutedBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="40,28,40,16" Spacing="16">
                        <TextBlock Text="{lang:Localize WhatIsVoiceGarden}"
                                    FontSize="18" FontWeight="SemiBold"
                                    Foreground="{StaticResource VGForegroundBrush}"/>

                        <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22"
                                    Foreground="{StaticResource VGForegroundBrush}"
                                    Text="{lang:Localize OnboardingDesc1}"/>

                        <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22"
                                    Foreground="{StaticResource VGForegroundBrush}"
                                    Text="{lang:Localize OnboardingDesc2}"/>

                        <Border Background="{StaticResource VGAccentBrush}"
                                CornerRadius="8" Padding="16,12" Margin="0,4,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{lang:Localize Feature20Engines}"
                                            FontSize="13" Foreground="{StaticResource VGForegroundBrush}"/>
                                <TextBlock Text="{lang:Localize FeatureOffline}"
                                            FontSize="13" Foreground="{StaticResource VGForegroundBrush}"/>
                                <TextBlock Text="{lang:Localize FeatureWordBoundary}"
                                            FontSize="13" Foreground="{StaticResource VGForegroundBrush}"/>
                                <TextBlock Text="{lang:Localize FeatureDualArch}"
                                            FontSize="13" Foreground="{StaticResource VGForegroundBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ===== PAGE 2: HOW TO USE ===== -->
                <StackPanel IsVisible="{Binding IsPage2}" Spacing="0">

                    <Border Background="{StaticResource VGAccentBrush}" Padding="40,32,40,20">
                        <TextBlock Text="{lang:Localize GettingStarted}"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource VGForegroundBrush}"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="40,24,40,16" Spacing="20">

                        <!-- Step 1: Install adapter -->
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Background="{StaticResource VGPrimaryBrush}"
                                        CornerRadius="14" Width="28" Height="28"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="1" FontSize="14" FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{lang:Localize Step1Title}"
                                            FontSize="16" FontWeight="SemiBold"
                                            Foreground="{StaticResource VGForegroundBrush}"
                                            VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                        Foreground="{StaticResource VGMutedBrush}"
                                        Margin="38,0,0,0"
                                        Text="{lang:Localize Step1Desc}"/>
                        </StackPanel>

                        <!-- Step 2: Download offline models -->
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Background="{StaticResource VGPrimaryBrush}"
                                        CornerRadius="14" Width="28" Height="28"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="2" FontSize="14" FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{lang:Localize Step2Title}"
                                            FontSize="16" FontWeight="SemiBold"
                                            Foreground="{StaticResource VGForegroundBrush}"
                                            VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                        Foreground="{StaticResource VGMutedBrush}"
                                        Margin="38,0,0,0"
                                        Text="{lang:Localize Step2Desc}"/>
                        </StackPanel>

                        <!-- Step 3: en-alias tip -->
                        <Border Background="#FFF7ED" CornerRadius="8" Padding="16,12" BorderBrush="#FDBA74" BorderThickness="1" Margin="38,0,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{lang:Localize LangCompatTip}"
                                            FontSize="13" FontWeight="SemiBold"
                                            Foreground="{StaticResource VGForegroundBrush}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                            Foreground="{StaticResource VGForegroundBrush}"
                                            Text="{lang:Localize LangCompatDesc}"/>
                            </StackPanel>
                        </Border>

                        <!-- Step 4: Cloud engine keys -->
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Background="{StaticResource VGPrimaryBrush}"
                                        CornerRadius="14" Width="28" Height="28"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="3" FontSize="14" FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{lang:Localize Step3Title}"
                                             FontSize="16" FontWeight="SemiBold"
                                             Foreground="{StaticResource VGForegroundBrush}"
                                             VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                        Foreground="{StaticResource VGMutedBrush}"
                                        Margin="38,0,0,0"
                                        Text="{lang:Localize Step3Desc}"/>
                        </StackPanel>

                        <!-- Step 5: Get your voices -->
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Background="{StaticResource VGPrimaryBrush}"
                                        CornerRadius="14" Width="28" Height="28"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="4" FontSize="14" FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{lang:Localize Step4Title}"
                                             FontSize="16" FontWeight="SemiBold"
                                             Foreground="{StaticResource VGForegroundBrush}"
                                             VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                        Foreground="{StaticResource VGMutedBrush}"
                                        Margin="38,0,0,0"
                                        Text="{lang:Localize Step4Desc}"/>
                        </StackPanel>

                    </StackPanel>
                </StackPanel>

                <!-- ===== PAGE 3: PRIVACY ===== -->
                <StackPanel IsVisible="{Binding IsPage3}" Spacing="0">

                    <Border Background="{StaticResource VGAccentBrush}" Padding="40,32,40,20">
                        <TextBlock Text="{lang:Localize HelpImprove}"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource VGForegroundBrush}"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="40,24,40,16" Spacing="16">

                        <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22"
                                    Foreground="{StaticResource VGForegroundBrush}"
                                    Text="{lang:Localize PrivacyIntro}"/>

                        <Border Background="{StaticResource VGAccentBrush}" CornerRadius="8" Padding="16,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{lang:Localize WhatWeCollect}" FontSize="13" FontWeight="SemiBold"
                                            Foreground="{StaticResource VGForegroundBrush}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                            Foreground="{StaticResource VGForegroundBrush}"
                                            Text="{lang:Localize WhatWeCollectList}"/>
                                <TextBlock Text="{lang:Localize WhatWeDontCollect}" FontSize="13" FontWeight="SemiBold"
                                            Foreground="{StaticResource VGForegroundBrush}"
                                            Margin="0,4,0,0"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                            Foreground="{StaticResource VGForegroundBrush}"
                                            Text="{lang:Localize WhatWeDontCollectList}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                    Foreground="{StaticResource VGMutedBrush}"
                                    Text="{lang:Localize PrivacyChangeAnytime}"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ========== FOOTER: page dots + nav buttons ========== -->
        <Border Grid.Row="1" Background="{StaticResource VGAccentBrush}"
                BorderBrush="{StaticResource VGBorderBrush}" BorderThickness="0,1,0,0"
                Padding="40,16">
            <Grid ColumnDefinitions="Auto, *, Auto">

                <!-- Page dots -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding Dot1Brush}"/>
                    <Ellipse Width="8" Height="8" Fill="{Binding Dot2Brush}"/>
                    <Ellipse Width="8" Height="8" Fill="{Binding Dot3Brush}"/>
                </StackPanel>

                <!-- Nav buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"
                            VerticalAlignment="Center">

                    <Button Content="{lang:Localize Back}"
                            Command="{Binding BackCommand}"
                            IsVisible="{Binding CanGoBack}"
                            Padding="20,8"/>

                    <!-- Page 1-2: Next -->
                    <Button Content="{lang:Localize Next}"
                            Command="{Binding NextCommand}"
                            IsVisible="{Binding CanGoNext}"
                            Padding="20,8"
                            Classes="Primary"/>

                    <!-- Page 3: No thanks -->
                    <Button Content="{lang:Localize NoThanks}"
                            Command="{Binding DeclineCommand}"
                            IsVisible="{Binding IsPage3}"
                            Padding="20,8"/>

                    <!-- Page 3: Yes -->
                    <Button Content="{lang:Localize YesHelpImprove}"
                            Command="{Binding AcceptCommand}"
                            IsVisible="{Binding IsPage3}"
                            Padding="20,8"
                            Classes="Primary"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
