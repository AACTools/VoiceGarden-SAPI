  <data name="AliasApplyNote" xml:space="preserve">
    <value>जेव्हा व्हॉईस टॅबमधून व्हॉईस इन्स्टॉल किंवा रिइन्स्टॉल केल्या जातात तेव्हा लागू केले जाते. विद्यमान व्हॉईस पुढील वेळी तुम्ही त्यांना इन्स्टॉल केल्यावर बदल ओळखतात.</value>
  </data>
  <data name="AliasArabicHint" xml:space="preserve">
    <value>उजव्या ते डाव्या भाषेतली मजकूर वाणी (अरबी, उर्दू, फारसी, हिब्रू, पश्तो…) देखील अरबी (ar-SA) अंतर्गत दिसते, त्यामुळे अरबी आवाजांसाठी सेट केलेल्या अॅप्सना ती सापडू शकते.</value>
  </data>
  <data name="AliasArabicLabel" xml:space="preserve">
