  </data>
  <data name="AliasEnUsHint" xml:space="preserve">
    <value>इतर कोणत्याही भाषेतील आवाजदेखील इंग्रजी (en-US) प्रमाणे दिसतो, त्यामुळे फक्त इंग्रजी आवाजांची यादी करणाऱ्या अॅप्स — काही AAC शीर्षकेसारखे — हे वापरू शकतात.</value>
  </data>
  <data name="AliasEnUsLabel" xml:space="preserve">
