  <data name="Step1Desc" xml:space="preserve">
    <value>ಮುಖ್ಯ ಪರದೆಯಲ್ಲಿ, 64-ಬಿಟ್‌ಗಾಗಿ ಸ್ಥಾಪಿಸು ಕ್ಲಿಕ್ ಮಾಡಿ (ಮತ್ತು ಅಗತ್ಯವಿದ್ದರೆ 32-ಬಿಟ್). ಇದು VoiceGarden ಅನ್ನು ಯಾವುದೇ ಹೊಂದಾಣಿಕೆಯ ಅಪ್ಲಿಕೇಶನ್ ಬಳಸಬಹುದಾದ SAPI 5 ಧ್ವನಿಯಾಗಿ ನೋಂದಾಯಿಸುತ್ತದೆ.</value>
  </data>
  <data name="Step1Title" xml:space="preserve">
    <value>SAPI ಅಡಾಪ್ಟರ್ ಅನ್ನು ಸ್ಥಾಪಿಸಿ</value>
  </data>
  <data name="Step2Desc" xml:space="preserve">
    <value>ಉಚಿತ ನರ ಧ್ವನಿಗಳನ್ನು ಬ್ರೌಸ್ ಮಾಡಲು ಮತ್ತು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು SherpaOnnx ಮಾಡೆಲ್ಸ್ ಟ್ಯಾಬ್‌ಗೆ ಹೋಗಿ. ಇವುಗಳು ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಸಂಪೂರ್ಣವಾಗಿ ರನ್ ಆಗುತ್ತವೆ - ಯಾವುದೇ ಇಂಟರ್ನೆಟ್ ಸಂಪರ್ಕದ ಅಗತ್ಯವಿಲ್ಲ. ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದ ನಂತರ, ಅವುಗಳನ್ನು SAPI ಅಪ್ಲಿಕೇಶನ್‌ಗಳಿಗೆ ಲಭ್ಯವಾಗುವಂತೆ ಮಾಡಲು ಪ್ರಚಾರವನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ.</value>
  </data>
  <data name="Step2Title" xml:space="preserve">
    <value>Sherpa Onnx ಧ್ವನಿಗಳನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ (ಆಫ್‌ಲೈನ್)</value>
  </data>
  <data name="Step3Desc" xml:space="preserve">
