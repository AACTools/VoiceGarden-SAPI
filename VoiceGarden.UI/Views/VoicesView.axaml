<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VoiceGarden.UI.ViewModels"
             xmlns:lang="using:VoiceGarden.UI.Markup"
             x:Class="VoiceGarden.UI.Views.VoicesView"
             x:DataType="vm:VoicesViewModel">

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto, Auto">

        <!-- Error banner: icon + text at the top, never colour alone -->
        <Border Grid.Row="0" Classes="Banner BannerError" IsVisible="{Binding HasError}"
                AutomationProperties.LiveSetting="Assertive">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="⚠" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="{Binding ErrorDetail}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"
                           IsVisible="{Binding ErrorDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           ToolTip.Tip="{Binding ErrorDetail}"/>
            </StackPanel>
        </Border>

        <!-- Header + primary actions -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="{lang:Localize TabVoicesTitle}" Classes="PageTitle"/>
                <TextBlock Text="{lang:Localize TabVoicesIntro}" Classes="Hint"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{lang:Localize LoadVoices}" Classes="Primary" Margin="0,0,10,0"
                    Command="{Binding LoadVoicesCommand}"
                    AutomationProperties.Name="{lang:Localize LoadVoices}"/>
            <Button Grid.Column="2" Content="{lang:Localize RefreshInstalled}"
                    Command="{Binding RefreshInstalledCommand}"
                    AutomationProperties.Name="{lang:Localize RefreshInstalled}"/>
        </Grid>

        <!-- Filters — wraps, never clips -->
        <Border Grid.Row="2" Classes="Card">
            <WrapPanel Classes="FilterRow">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{lang:Localize Engine}" Classes="SectionLabel" VerticalAlignment="Center"/>
                    <ComboBox SelectedItem="{Binding EngineFilter}" ItemsSource="{Binding EngineOptions}"
                              MinWidth="140"
                              AutomationProperties.Name="{lang:Localize FilterEngine}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{lang:Localize Language}" Classes="SectionLabel" VerticalAlignment="Center"/>
                    <ComboBox SelectedItem="{Binding LanguageFilter}" ItemsSource="{Binding LanguageOptions}"
                              MinWidth="130"
                              AutomationProperties.Name="{lang:Localize FilterLanguage}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{lang:Localize Gender}" Classes="SectionLabel" VerticalAlignment="Center"/>
                    <ComboBox SelectedItem="{Binding GenderFilter}" ItemsSource="{Binding GenderOptions}"
                              MinWidth="110"
                              AutomationProperties.Name="{lang:Localize FilterGender}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{lang:Localize Quality}" Classes="SectionLabel" VerticalAlignment="Center"/>
                    <ComboBox SelectedItem="{Binding QualityFilter}" ItemsSource="{Binding QualityOptions}"
                              MinWidth="110"
                              AutomationProperties.Name="{lang:Localize FilterQuality}"/>
                </StackPanel>
                <TextBox Text="{Binding SearchText}" PlaceholderText="{lang:Localize SearchVoices}" MinWidth="190"
                         AutomationProperties.Name="{lang:Localize SearchVoices}"/>
                <CheckBox Content="{lang:Localize FilterInstalledOnly}" IsChecked="{Binding InstalledOnly}"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{lang:Localize FilterInstalledOnly}"/>
                <Button Content="{lang:Localize All}" Command="{Binding SelectAllCommand}"
                        AutomationProperties.Name="{lang:Localize SelectAllVoices}"/>
                <Button Content="{lang:Localize None}" Command="{Binding SelectNoneCommand}"
                        AutomationProperties.Name="{lang:Localize DeselectAllVoices}"/>
            </WrapPanel>
        </Border>

        <!-- Voice list -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource SystemControlDefaultChromeMediumLowBrush}"
                BorderThickness="1" CornerRadius="10" MinHeight="220" Margin="0,0,0,14">
            <Grid>
                <ListBox ItemsSource="{Binding FilteredVoices}" Background="Transparent"
                         AutomationProperties.Name="{lang:Localize TabVoicesTitle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:VoiceEntry">
                            <Grid ColumnDefinitions="*, Auto, Auto" MinHeight="56">
                                <Grid.Styles>
                                    <Style Selector="Button.Compact">
                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                    </Style>
                                </Grid.Styles>
                                <!-- Whole text area toggles selection (chunky target) -->
                                <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="{Binding AutomationLabel, StringFormat='Select {0}'}"
                                          AutomationProperties.HelpText="{Binding Language}">
                                    <StackPanel Spacing="4" Margin="0,2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding DetailsToolTip}"/>
                                            <Border Classes="Badge BadgeQuality" IsVisible="{Binding !!QualityBadge.Length}"
                                                    ToolTip.Tip="{lang:Localize Quality}">
                                                <TextBlock Text="{Binding QualityBadge}"/>
                                            </Border>
                                            <Border Classes="Badge BadgeNoCreds" IsVisible="{Binding !!QuantizationBadge.Length}"
                                                    ToolTip.Tip="{Binding QuantizationBadge, StringFormat='Weights: {0}'}">
                                                <TextBlock Text="{Binding QuantizationBadge}"/>
                                            </Border>
                                            <Border Classes="Badge BadgeGender" IsVisible="{Binding !!GenderLabel.Length}"
                                                    ToolTip.Tip="{lang:Localize Gender}">
                                                <TextBlock Text="{Binding GenderLabel}"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding EngineName}" Classes="Hint"/>
                                            <TextBlock Text="{Binding Language}" Classes="Hint"/>
                                            <!-- Internal ID only when the display name is duplicated -->
                                            <TextBlock Text="{Binding Id}" Classes="Hint" Opacity="0.55" TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding ShowId}"/>
                                            <TextBlock Text="{Binding SizeText}" Classes="Hint"
                                                       IsVisible="{Binding !!SizeText.Length}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                            Margin="0,0,16,0">
                                    <Border Classes="Badge BadgeInstalled" IsVisible="{Binding IsInstalled}"
                                            ToolTip.Tip="{lang:Localize Installed}">
                                        <TextBlock Text="{lang:Localize Installed}"/>
                                    </Border>
                                    <TextBlock Text="{lang:Localize Downloaded}" Classes="Hint" Foreground="#166534"
                                               IsVisible="{Binding IsDownloaded}" VerticalAlignment="Center"
                                               AutomationProperties.LiveSetting="Polite"/>
                                    <ProgressBar Value="{Binding DownloadProgress}" IsVisible="{Binding IsDownloading}"
                                                 Width="110" Height="14" MinWidth="110" VerticalAlignment="Center"
                                                 AutomationProperties.Name="Download progress"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Classes="Compact Secondary" Content="{lang:Localize PreviewVoice}"
                                            Command="{Binding $parent[ListBox].((vm:VoicesViewModel)DataContext).PreviewCommand}"
                                            CommandParameter="{Binding}" IsEnabled="{Binding CanPreview}"
                                            AutomationProperties.Name="{Binding AutomationLabel, StringFormat='Preview {0}'}"/>
                                    <Button Classes="Compact Secondary" Content="{lang:Localize Download}"
                                            Command="{Binding $parent[ListBox].((vm:VoicesViewModel)DataContext).DownloadCommand}"
                                            CommandParameter="{Binding}" IsVisible="{Binding ShowDownload}"
                                            AutomationProperties.Name="{Binding AutomationLabel, StringFormat='Download {0}'}"/>
                                    <Button Classes="Compact Primary" Content="{lang:Localize Install}"
                                            Command="{Binding $parent[ListBox].((vm:VoicesViewModel)DataContext).PromoteCommand}"
                                            CommandParameter="{Binding}" IsEnabled="{Binding CanPromote}"
                                            AutomationProperties.Name="{Binding AutomationLabel, StringFormat='Install {0} to SAPI'}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty state: guide the user back to the earlier tabs -->
                <StackPanel IsVisible="{Binding ShowEmptyState}" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="10" Margin="20">
                    <TextBlock Text="{lang:Localize VoicesEmptyTitle}" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{lang:Localize VoicesEmptyHint}" Classes="Hint" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <Button Content="{lang:Localize LoadVoices}" Classes="Primary" HorizontalAlignment="Center"
                            Command="{Binding LoadVoicesCommand}"
                            AutomationProperties.Name="{lang:Localize LoadVoices}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="{Binding CountSummary}" Classes="SectionLabel" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"/>
            <Button Grid.Column="1" Content="{lang:Localize InstallSelected}" Classes="Primary" Margin="0,0,10,0"
                    Command="{Binding PromoteSelectedCommand}"
                    AutomationProperties.Name="{lang:Localize InstallSelected}"/>
            <Button Grid.Column="2" Content="{lang:Localize RemoveSelected}" Classes="Secondary"
                    Command="{Binding UnpromoteSelectedCommand}"
                    AutomationProperties.Name="{lang:Localize RemoveSelected}"/>
        </Grid>

        <!-- Status line (progress + counts) -->
        <TextBlock Grid.Row="5" Text="{Binding StatusText}" Classes="Hint"
                   AutomationProperties.LiveSetting="Polite"/>

    </Grid>
</UserControl>
