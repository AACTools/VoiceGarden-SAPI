<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VoiceGarden.UI.ViewModels"
             xmlns:lang="using:VoiceGarden.UI.Markup"
             x:Class="VoiceGarden.UI.Views.VoiceConfigView">

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">

        <!-- Engine selector only — credentials come from Configure Credentials -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="{lang:Localize Engine}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" SelectedItem="{Binding CurrentEngine}"
                      ItemsSource="{Binding AvailableEngines}" MinWidth="120" Margin="0,0,8,0"
                      AutomationProperties.Name="TTS engine selector"/>
            <Button Grid.Column="2" Content="{lang:Localize FetchVoices}" Command="{Binding FetchVoicesCommand}"
                    Classes="Primary" Padding="16,4"
                    AutomationProperties.Name="Fetch available voices"/>
        </Grid>

        <!-- Status + action buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="{Binding ValidationResult}" VerticalAlignment="Center"
                       Classes="Hint" IsVisible="{Binding IsValidated}"/>
            <Button Content="{lang:Localize InstallSelected}" Command="{Binding PromoteSelectedCommand}"
                    Classes="Primary" Padding="16,4"
                    AutomationProperties.Name="Install selected voices to SAPI"/>
            <Button Content="{lang:Localize Uninstall}" Command="{Binding UnpromoteSelectedCommand}"
                    Padding="16,4"
                    AutomationProperties.Name="Uninstall selected voices"/>
        </StackPanel>

        <!-- Search + select controls -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,8">
            <TextBox Grid.Column="0" Text="{Binding SearchFilter}" Watermark="{lang:Localize SearchVoices}"
                     MinWidth="200"
                     AutomationProperties.Name="Search voices"/>
            <Button Grid.Column="1" Content="{lang:Localize All}" Command="{Binding SelectAllCommand}"
                    Padding="12,2" Margin="8,0,4,0" FontSize="12"
                    AutomationProperties.Name="Select all voices"/>
            <Button Grid.Column="2" Content="{lang:Localize None}" Command="{Binding SelectNoneCommand}"
                    Padding="12,2" Margin="4,0,0,0" FontSize="12"
                    AutomationProperties.Name="Deselect all voices"/>
        </Grid>

        <!-- Voice list -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource SystemControlDefaultChromeMediumLowBrush}"
                BorderThickness="1" CornerRadius="4" MinHeight="200">
            <ListBox ItemsSource="{Binding FilteredVoices}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:VoiceItem">
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Language}"
                                       Classes="Hint" Margin="16,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{lang:Localize Installed}"
                                       Classes="Hint" Foreground="Green"
                                       IsVisible="{Binding IsInstalled}"
                                       Margin="8,0,8,0" VerticalAlignment="Center"/>
                            <Button Grid.Column="4" Content="▶" FontSize="10"
                                    Click="PreviewVoice_Click"
                                    Tag="{Binding Id}"
                                    Padding="6,2" Margin="0,0,0,0" ToolTip.Tip="{lang:Localize PreviewVoice}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Status bar -->
        <Grid Grid.Row="4" ColumnDefinitions="*, Auto" Margin="0,8,0,0">
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" Classes="Hint"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} selected'}" Classes="Hint"/>
                <TextBlock Text="{Binding InstalledCount, StringFormat='{}{0} installed'}" Classes="Hint"/>
                <TextBlock Text="{Binding TotalVoices, StringFormat='{}{0} total'}" Classes="Hint"/>
            </StackPanel>
        </Grid>

    </Grid>

    <UserControl.Styles>
        <Style Selector="TextBlock.Hint">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style Selector="Button.Primary">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Styles>

</UserControl>
