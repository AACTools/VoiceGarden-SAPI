<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VoiceGarden.UI.ViewModels"
             xmlns:lang="using:VoiceGarden.UI.Markup"
             x:Class="VoiceGarden.UI.Views.AdvancedView"
             x:DataType="vm:MainViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4" Margin="0,0,0,16">

            <TextBlock Text="{lang:Localize Advanced}" Classes="PageTitle" Margin="0,0,0,10"/>
            <TextBlock Text="{lang:Localize AdvancedIntro}" Classes="Hint" Margin="0,0,0,14"/>

            <!-- Adapter installation -->
            <Border Classes="Card">
                <StackPanel Spacing="12">
                    <TextBlock Text="{lang:Localize AdapterInstallation}" Classes="CardHeader"/>
                    <Border Background="{StaticResource VGAccentBrush}" CornerRadius="8" Padding="14,10">
                        <Grid ColumnDefinitions="*, Auto, Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Status64Bit}" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <Button Grid.Column="1" Content="{Binding Install64Text}" Classes="Secondary" Margin="0,0,10,0"
                                    Command="{Binding Install64Command}"
                                    AutomationProperties.Name="Register 64-bit adapter"/>
                            <Button Grid.Column="2" Content="{lang:Localize Uninstall}" Classes="Secondary"
                                    Command="{Binding Uninstall64Command}"
                                    IsEnabled="{Binding Is64Installed}"
                                    AutomationProperties.Name="Unregister 64-bit adapter"/>
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource VGAccentBrush}" CornerRadius="8" Padding="14,10">
                        <Grid ColumnDefinitions="*, Auto, Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Status32Bit}" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <Button Grid.Column="1" Content="{Binding Install32Text}" Classes="Secondary" Margin="0,0,10,0"
                                    Command="{Binding Install32Command}"
                                    AutomationProperties.Name="Register 32-bit adapter"/>
                            <Button Grid.Column="2" Content="{lang:Localize Uninstall}" Classes="Secondary"
                                    Command="{Binding Uninstall32Command}"
                                    IsEnabled="{Binding Is32Installed}"
                                    AutomationProperties.Name="Unregister 32-bit adapter"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- SAPI voice aliases -->
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <TextBlock Text="{lang:Localize AliasSettingsTitle}" Classes="CardHeader"/>
                    <TextBlock Text="{lang:Localize AliasSettingsIntro}" Classes="Hint"/>
                    <CheckBox Content="{lang:Localize AliasEnUsLabel}" IsChecked="{Binding SapiAliasEnUs}"
                              AutomationProperties.Name="{lang:Localize AliasEnUsLabel}"
                              AutomationProperties.HelpText="{lang:Localize AliasEnUsHint}"/>
                    <TextBlock Text="{lang:Localize AliasEnUsHint}" Classes="Hint" Margin="28,0,0,0"/>
                    <CheckBox Content="{lang:Localize AliasArabicLabel}" IsChecked="{Binding SapiAliasArabic}"
                              AutomationProperties.Name="{lang:Localize AliasArabicLabel}"
                              AutomationProperties.HelpText="{lang:Localize AliasArabicHint}"/>
                    <TextBlock Text="{lang:Localize AliasArabicHint}" Classes="Hint" Margin="28,0,0,0"/>
                    <TextBlock Text="{lang:Localize AliasApplyNote}" Classes="Hint" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Offline models -->
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <TextBlock Text="{lang:Localize AdvancedModelsTitle}" Classes="CardHeader"/>
                    <TextBlock Text="{Binding SherpaModelSummary}" Classes="Hint"
                               AutomationProperties.LiveSetting="Polite"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="{lang:Localize OpenModelsFolder}" Classes="Secondary" Command="{Binding OpenModelsFolderCommand}"
                                AutomationProperties.Name="{lang:Localize OpenModelsFolder}"/>
                        <Button Content="{lang:Localize OpenLogs}" Classes="Secondary" Command="{Binding OpenLogsCommand}"
                                AutomationProperties.Name="{lang:Localize OpenLogs}"/>
                    </StackPanel>
                    <TextBlock Text="{lang:Localize AdvancedModelsHint}" Classes="Hint"/>
                </StackPanel>
            </Border>

            <!-- Settings -->
            <Border Classes="Card">
                <StackPanel Spacing="12">
                    <TextBlock Text="{lang:Localize AdvancedSettings}" Classes="CardHeader"/>
                    <CheckBox Content="{lang:Localize EnableAnalytics}" IsChecked="{Binding AnalyticsEnabled}"
                              AutomationProperties.HelpText="{lang:Localize AnalyticsHint}"/>
                    <TextBlock Text="{lang:Localize AnalyticsHint}" Classes="Hint" Margin="28,0,0,0"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{lang:Localize LogLevel}" VerticalAlignment="Center"/>
                        <ComboBox SelectedIndex="{Binding LogLevelIndex}" MinWidth="130"
                                  AutomationProperties.Name="{lang:Localize LogLevel}">
                            <ComboBoxItem Content="Trace"/>
                            <ComboBoxItem Content="Debug"/>
                            <ComboBoxItem Content="Info"/>
                            <ComboBoxItem Content="Warning"/>
                            <ComboBoxItem Content="Error"/>
                            <ComboBoxItem Content="Critical"/>
                            <ComboBoxItem Content="Off"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Classes="Card">
                <StackPanel Spacing="8">
                    <TextBlock Text="{lang:Localize About}" Classes="CardHeader"/>
                    <TextBlock Text="{Binding AboutText}" Classes="Hint"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
