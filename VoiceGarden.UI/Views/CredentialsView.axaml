<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VoiceGarden.UI.ViewModels"
             xmlns:lang="using:VoiceGarden.UI.Markup"
             x:Class="VoiceGarden.UI.Views.CredentialsView"
             x:DataType="vm:CredentialsViewModel">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Intro -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="4">
            <TextBlock Text="{lang:Localize TabCredentialsTitle}" Classes="PageTitle"/>
            <TextBlock Text="{Binding StatusText}" Classes="Hint"
                       AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>

        <!-- Credential forms -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="10">
                <ItemsControl ItemsSource="{Binding Forms}"
                              AutomationProperties.Name="{lang:Localize TabCredentialsTitle}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CredentialsForm">
                            <Border Classes="Card">
                                <Grid RowDefinitions="Auto, Auto, Auto, Auto" ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource VGForegroundBrush}" VerticalAlignment="Center"/>
                                        <Border Classes="Badge BadgeCreds" ToolTip.Tip="{lang:Localize BadgeCredsNeeded}">
                                            <TextBlock Text="{lang:Localize BadgeCredsNeeded}"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Setting.ApiKey}"
                                             PlaceholderText="{Binding PrimaryLabel}" PasswordChar="*" MinHeight="44"
                                             Margin="0,0,10,10"
                                             AutomationProperties.Name="{Binding DisplayName, StringFormat='{}{0} API key'}"/>
                                    <Button Grid.Row="1" Grid.Column="1" Content="{lang:Localize Verify}"
                                            Command="{Binding VerifyCommand}"
                                            IsEnabled="{Binding Setting.HasKey}" VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding DisplayName, StringFormat='Verify {0} credentials'}"/>

                                    <TextBox Grid.Row="2" Grid.Column="0" Text="{Binding Setting.Region}"
                                             PlaceholderText="{Binding SecondaryLabel}" MinHeight="44" Margin="0,0,10,0"
                                             IsVisible="{Binding NeedsSecondary}"
                                             AutomationProperties.Name="{Binding SecondaryLabel}"/>

                                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"
                                                IsVisible="{Binding !!Setting.VerificationDetail.Length}">
                                        <TextBlock Text="{Binding Setting.VerificationIcon}" FontSize="18" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Setting.VerificationDetail}" Classes="Hint" VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer: next step -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto, Auto">
            <TextBlock Grid.Column="0" Text="{lang:Localize CredentialsFooterHint}" Classes="Hint" VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="{lang:Localize BackToEngines}" Margin="0,0,10,0"
                    Command="{Binding GoToEnginesCommand}"
                    AutomationProperties.Name="{lang:Localize BackToEngines}"/>
            <Button Grid.Column="2" Content="{lang:Localize NextVoices}" Classes="Primary"
                    Command="{Binding GoToVoicesCommand}"
                    AutomationProperties.Name="{lang:Localize NextVoices}"/>
        </Grid>

    </Grid>
</UserControl>
